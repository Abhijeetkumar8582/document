
# --- Browser access ------------------------------------------------------
# Leave blank to accept API calls from any origin (the default; there is no login yet so nothing is exposed).
# Once authentication is added, list the exact frontend origin(s) here, comma-separated.
CORS_ORIGINS=

# Ask Gemini to structure a text-layer document when the regex parser finds fewer than this share of fields (0 disables).
LLM_ASSIST_BELOW=0.75
